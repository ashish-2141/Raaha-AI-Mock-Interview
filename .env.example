NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-5.5
DATABASE_URL=
REDIS_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional college pilot cohort. Provide this code to enrolled participants only.
RAAHA_PILOT_COLLEGE_ID=
RAAHA_PILOT_INVITE_CODE=

# JSON object mapping Supabase auth user IDs to allowed college IDs, e.g. {"<TPO_USER_UUID>":"<college-id>"}.
RAAHA_COLLEGE_DASHBOARD_ACCESS_JSON={}

# Operations summaries are restricted to these Supabase auth user IDs.
RAAHA_OPERATIONS_ADMIN_USER_IDS=

# Set only when token-based cost estimates are desired. Rates are USD per 1M tokens.
RAAHA_OPENAI_INPUT_USD_PER_1M=
RAAHA_OPENAI_OUTPUT_USD_PER_1M=
